<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HTTP requests to the ESP32 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Find / watch the Wi-Fi network and detect when it is lost -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required by ConnectivityManager.requestNetwork (bind traffic to the ESP32 Wi-Fi) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Check whether Wi-Fi is switched on -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
        No location / NEARBY_WIFI_DEVICES permission is needed: the app never scans for
        networks and never reads the SSID. Joining DRONE_CONTROLLER (Android 10+) uses the
        system's own approval dialog (WifiNetworkSpecifier).
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AERONIX">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
